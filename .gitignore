# dependencies
node_modules/
.pnp/
.pnp.js

# next.js
.next/
# Output of a verification build run with NEXT_DIST_DIR set, so it does not
# disturb a dev server already using .next/
.next-*/
out/
build/
dist/

# typescript build info
*.tsbuildinfo

# env files
.env
.env.local
.env*.local
/scripts/.env
.env.example.local

# generated data
# questions.json and topics.json ARE tracked: they are the product. The host
# runs `npm run seed` to build the SQLite database from them at deploy time, so
# if they are not in the repo the deployed site has no question bank. Keeping
# them tracked also makes content repairs reviewable in a diff.
/data/generated/*
!/data/generated/.gitkeep
!/data/generated/questions.json
!/data/generated/topics.json

# logs
logs/
*.log
npm-debug.log*

# os
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# sqlite dev db
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal

# vercel
.vercel

# source material (not redistributed)
/data/source/
